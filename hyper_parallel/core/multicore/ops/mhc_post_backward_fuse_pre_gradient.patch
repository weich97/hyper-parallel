 template <typename T>
+__aicore__ inline void KernelMhcPostBackward<T>::EnablePreGradient(
+    GM_ADDR residual, GM_ADDR gradInput, GM_ADDR gradCube, GM_ADDR preCoefficients, GM_ADDR gradRsqrt, TPipe *pipe)
+{
+    this->fusePreGradient = true;
+    this->preResidualGm.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(residual));
+    this->gradInputGm.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(gradInput));
+    this->gradCubeGm.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(gradCube));
+    this->preCoefficientsGm.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(preCoefficients));
+    this->gradRsqrtGm.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(gradRsqrt));
+    pipe->InitBuffer(this->preCoefficientsBuf, 32);
+    pipe->InitBuffer(this->preRsqrtBuf, 32);
+    this->preCoefficientsUb = this->preCoefficientsBuf.template Get<float>();
+    this->preRsqrtUb = this->preRsqrtBuf.template Get<float>();
+}
+
+template <typename T>
+__aicore__ inline void KernelMhcPostBackward<T>::LoadPreGradientTile(
+    uint64_t token, uint32_t offset, uint32_t channels)
+{
+    // These two buffers were the prior channel tile's BF16 output staging.
+    SetFlag<HardEvent::MTE3_MTE2>(3);
+    WaitFlag<HardEvent::MTE3_MTE2>(3);
+    const uint64_t residualOffset = token * this->n * this->channel + offset;
+    const uint16_t rows = static_cast<uint16_t>(this->n);
+    const uint32_t gap = this->channel - channels;
+    DataCopyExtParams residualCopy{rows, static_cast<uint32_t>(channels * sizeof(T)), static_cast<uint32_t>(gap * sizeof(T)), 0, 0};
+    DataCopyExtParams cubeCopy{rows, static_cast<uint32_t>(channels * sizeof(float)), static_cast<uint32_t>(gap * sizeof(float)), 0, 0};
+    DataCopyExtParams inputCopy{1, static_cast<uint32_t>(channels * sizeof(T)), 0, 0, 0};
+    DataCopyPad(this->dxLCastUb, this->preResidualGm[residualOffset], residualCopy, this->padParams);
+    DataCopyPad(this->dHLResTmp1, this->gradCubeGm[residualOffset], cubeCopy, this->padParamsFloat);
+    DataCopyPad(this->dFOutCastUb, this->gradInputGm[token * this->channel + offset], inputCopy, this->padParams);
+}
+
+template <typename T>
+__aicore__ inline void KernelMhcPostBackward<T>::MergePreGradient(uint32_t channels)
+{
+    const uint32_t values = this->n * channels;
+    Cast(this->dxLUb, this->dxLCastUb, RoundMode::CAST_NONE, values);
+    Cast(this->dFOutUb, this->dFOutCastUb, RoundMode::CAST_NONE, channels);
+    PipeBarrier<PIPE_V>();
+    for (uint32_t row = 0; row < this->n; ++row) {
+        Muls(this->dFPostResUb[row * channels], this->dFOutUb, this->preCoefficientsUb.GetValue(row), channels);
+    }
+    PipeBarrier<PIPE_V>();
+    Axpy(this->dFPostResUb, this->dxLUb, this->preRsqrtUb.GetValue(0), values);
+    PipeBarrier<PIPE_V>();
+    Add(this->dFPostResUb, this->dHLResTmp1, this->dFPostResUb, values);
+    // Preserve the former BF16 rounding boundary before adding the upstream residual gradient.
+    PipeBarrier<PIPE_V>();
+    Cast(this->dFPostResCastUb, this->dFPostResUb, RoundMode::CAST_RINT, values);
+    PipeBarrier<PIPE_V>();
+    Cast(this->dFPostResUb, this->dFPostResCastUb, RoundMode::CAST_NONE, values);
+}
